      "css": ".ds-header{display:flex;align-items:center;flex-wrap:wrap;gap:18px;padding:0 10px;background:var(--paper,#131211);border-bottom:1px solid var(--border,#3a3029)}.ds-brand{display:inline-flex;align-items:center;gap:7px;color:var(--ink,#faf7f2);font:700 1.32rem/1 \"Bricolage Grotesque Variable\",\"Segoe UI\",sans-serif;letter-spacing:-.036em;text-decoration:none}.ds-nav{display:flex;gap:19px;min-height:54px}.ds-nav button{display:inline-flex;align-items:center;gap:7px;padding:2px 3px 0;border:0;border-bottom:2px solid transparent;background:none;color:var(--quiet,#b5a99e);font:500 13px \"Bricolage Grotesque Variable\",\"Segoe UI\",sans-serif;cursor:pointer}.ds-nav button:hover{color:var(--ink,#faf7f2);text-decoration:underline}.ds-nav button[aria-current=page]{color:var(--ink,#faf7f2);border-bottom-color:var(--accent,#ff6a1a);font-weight:700}.ds-nav button[aria-current=page] svg{color:var(--accent,#ff6a1a)}.ds-nav button:focus-visible,.ds-brand:focus-visible{outline:2px solid var(--accent,#ff6a1a);outline-offset:3px}"
