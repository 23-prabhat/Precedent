      "css": ".ds-open-scene{display:grid;grid-template-columns:minmax(0,.93fr) minmax(0,1.07fr);align-items:center;gap:12px;margin:0;padding:14px;background:radial-gradient(ellipse at 71% 48%,#28150d 0%,#140e0b 42%,#090909 74%);color:#faf7f2;font:14px/1.5 \"Bricolage Grotesque Variable\",\"Segoe UI\",sans-serif}.ds-graph-copy h3{margin:0;font-size:clamp(1.85rem,5vw,3.3rem);font-weight:650;line-height:.9;letter-spacing:-.04em}.ds-retrieval{display:flex;gap:14px;margin-top:16px;flex-wrap:wrap}.ds-retrieval button{background:none;border:0;border-bottom:1px solid transparent;padding:7px 0;color:#c6b2a3;font:620 .75rem/1.5 \"Bricolage Grotesque Variable\",\"Segoe UI\",sans-serif;cursor:pointer}.ds-retrieval button:is(:hover,[aria-pressed=true]){color:#faf7f2;border-color:#ff6a1a}.ds-retrieval button:focus-visible{outline:2px solid #ff6a1a;outline-offset:3px}.ds-open-scene .ds-route{display:flex;align-items:center;gap:5px;margin-top:10px;color:#ffa06f;font:.62rem \"IBM Plex Mono\",monospace;white-space:nowrap}.ds-open-scene .ds-route span{flex:1;min-width:3px;height:1px;background:#ff6a1a}.ds-open-scene>svg{display:block;width:100%;height:auto;overflow:visible}.ds-node-labels{fill:#ffefdc;text-anchor:middle;font:9px \"IBM Plex Mono\",monospace}.ds-node-labels .ds-service{fill:#e9b290;font-size:8px}@media(max-width:420px){.ds-open-scene{grid-template-columns:minmax(0,1fr);gap:0}.ds-open-scene>svg{max-height:190px}}"
    }
